new file mode 100644
--- /dev/null
+++ b/src/components/StatusFilter.jsx
@@ -0,0 +1,20 @@
+import { useState } from "react";
+
+export function StatusFilter({ statuses, onChange }) {
+  const [active, setActive] = useState("all");
+
+  const select = (s) => {
+    setActive(s);
+    onChange(s);
+  };
+
+  return (
+    <div role="tablist" aria-label="Filter tickets by status">
+      {["all", ...statuses].map((s) => (
+        <button key={s} role="tab" aria-selected={active === s} onClick={() => select(s)}>
+          {s}
+        </button>
+      ))}
+    </div>
+  );
+}
diff --git a/src/components/StatusFilter.test.jsx b/src/components/StatusFilter.test.jsx
