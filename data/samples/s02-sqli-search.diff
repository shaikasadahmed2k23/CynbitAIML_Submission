@@ -0,0 +1,14 @@
+import sqlite3
+from flask import Flask, request, jsonify
+
+app = Flask(__name__)
+
+
+@app.route("/search")
+def search():
+    name = request.args.get("name", "")
+    conn = sqlite3.connect("app.db")
+    cur = conn.cursor()
+    cur.execute(f"SELECT id, name, email FROM users WHERE name = '{name}'")
+    rows = cur.fetchall()
+    return jsonify(rows)
